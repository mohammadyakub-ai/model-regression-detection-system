# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.

# LLM provider - default is OpenAI. Point at any OpenAI-compatible endpoint.
# For Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1
#OPENAI_BASE_URL=

# API key - use OPENAI_API_KEY (OpenAI) OR GROQ_API_KEY (Groq).
# OpenAI keys: sk-proj-... (get at platform.openai.com)
# Groq keys:   gsk_... (get at console.groq.com, free tier available)
OPENAI_API_KEY=sk-proj-...
#GROQ_API_KEY=gsk_...

# Slack incoming webhook URL - required for alerts.
# Create one in your Slack app: Features > Incoming Webhooks.
# Format: https://hooks.slack.com/services/T000/B000/XXXX
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Evaluation thresholds in percentage points of pass rate.
# Warning flag when the pass-rate delta exceeds this (default 3%).
EVAL_WARNING_PCT=3.0
# Critical flag / merge-block when the pass-rate delta exceeds this (default 8%).
EVAL_CRITICAL_PCT=8.0